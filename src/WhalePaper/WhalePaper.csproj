<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>WhalePaper</AssemblyName>
    <RootNamespace>WhalePaper</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WhalePaper.Program</StartupObject>
    <Deterministic>true</Deterministic>
    <Version>1.0.7</Version>
    <FileVersion>1.0.7.0</FileVersion>
    <Company>WhalePaper</Company>
    <Product>鲸鱼壁纸</Product>
    <Description>本地静态与动态桌面壁纸</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\default-wallpaper.png" />
  </ItemGroup>

</Project>
